---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/ContactForm.astro';
import company from '@data/company.json';
---

<BaseLayout
  title="Let's Talk About Your Plant"
  description="Tell us about your operation and what's on your mind. No RFPs, no questionnaires, just a conversation about your food manufacturing challenges."
>
  <section class="bg-white py-20">
    <div class="container mx-auto px-6">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12">
          <!-- Contact Info -->
          <div>
            <h1 class="font-heading text-4xl md:text-5xl font-bold text-charcoal mb-6">
              Let's Talk About Your Plant
            </h1>
            <p class="text-lg text-charcoal-light mb-8 leading-relaxed">
              Tell us a little about your operation and what's on your mind. No RFPs, no questionnaires, just a conversation.
            </p>

            <div class="space-y-8">
              <div>
                <h3 class="font-heading font-bold text-charcoal mb-2">Prefer to skip the form? Email us directly.</h3>
                <p class="text-charcoal-light">
                  <a
                    href={`mailto:${company.email}`}
                    class="text-copper hover:text-copper-dark transition-colors font-medium">
                    {company.email}
                  </a>
                </p>
              </div>

              <div>
                <h3 class="font-heading font-bold text-charcoal mb-2">Location</h3>
                <p class="text-charcoal-light">
                  Based in the Midwest, on-site when you need us
                </p>
              </div>

              <div class="bg-linen rounded-lg p-6">
                <h3 class="font-heading font-bold text-charcoal mb-3">What to Expect</h3>
                <p class="text-charcoal-light leading-relaxed">
                  We'll get back to you within one business day. First conversations are usually 30 minutes. We'll ask about your plant, your process, and where things are breaking down. No pitch decks.
                </p>
              </div>
            </div>
          </div>

          <!-- Contact Form -->
          <div class="bg-white p-8 rounded-lg border border-charcoal/10 shadow-sm">
            <ContactForm source="contact-page" />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
