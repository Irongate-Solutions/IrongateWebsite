---
import CapabilityLayout from '@components/CapabilityLayout.astro';
---

<CapabilityLayout
  title="Quality & Compliance: Food Manufacturing Traceability"
  headline="Audit-ready in minutes, not days."
  description="Food manufacturers live and die by their ability to trace. We connect every point in your operation so compliance documentation generates itself, and traceability is always ready, not assembled under pressure."
  capabilities={[
    "Full batch traceability (raw material to finished good)",
    "SQF / FSMA / HACCP documentation automation",
    "X-ray and metal detection integration",
    "Lab data management",
    "Environmental monitoring and swab tracking",
    "Regulatory audit support and report generation",
    "Recall simulation and execution"
  ]}
  painPoints={[
    "Three-day recall exercises that should take 30 minutes",
    "Paper-based compliance binders that nobody trusts",
    "Traceability gaps between departments: receiving says one thing, production says another",
    "Auditor requests that send people digging through filing cabinets for hours"
  ]}
  outcome="When an auditor asks 'show me every lot that used ingredient X from supplier Y on March 12,' the answer takes minutes, not a weekend."
/>
