---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactCTA from '@components/ContactCTA.astro';
import company from '@data/company.json';
---

<BaseLayout
  title="About Us: Building Manufacturing Software"
  description="A small team with deep domain expertise in food manufacturing software. Long tenures, long partnerships, and a relentless focus on the plant floor."
>
  <!-- Hero -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl">
        <div class="inline-block px-4 py-2 bg-copper/10 text-copper font-semibold rounded-full text-sm mb-6">
          Serving the Midwest
        </div>
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-charcoal mb-6">
          We understand, so we can build alongside you.
        </h1>
        <p class="text-xl text-charcoal-light leading-relaxed">
          We focus on a deep understanding of your systems to support your operation for years to come.
        </p>
      </div>
    </div>
  </section>

  <!-- Who We Are -->
  <section class="py-20">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-heading text-3xl font-bold mb-8">Who We Are</h2>
        <div class="space-y-6 text-lg text-charcoal-light leading-relaxed">
          <p>
            Irongate Solutions is a family-owned software development company that works primarily with food manufacturers.
            Our team has been building these systems for the better part of two decades and has a
            good idea of the obstacles that these companies need to solve.
          </p>
          <p>
            We're not a large firm with layers of managers between you and the people performing your work.
            When you call us, you're talking with someone who knows your company, your operations,
            and your values.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Believe -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-heading text-3xl font-bold mb-12 text-center">What We Believe</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center p-6">
            <div class="w-16 h-16 bg-copper/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-copper" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="font-heading text-xl font-bold mb-3">Long-term partnerships</h3>
            <p class="text-charcoal-light">
              Manufacturing plants don't stop changing and evolving.
              Our goal is to be there with you as your software needs change as well.
            </p>
          </div>

          <div class="text-center p-6">
            <div class="w-16 h-16 bg-copper/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-copper" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
            </div>
            <h3 class="font-heading text-xl font-bold mb-3">
              Understanding the operation</h3>
            <p class="text-charcoal-light">
            We believe that nothing is a substitute for spending time
            at your site, where we can see how you actually operate.
            </p>
          </div>

          <div class="text-center p-6">
            <div class="w-16 h-16 bg-copper/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-copper" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="font-heading text-xl font-bold mb-3">Software should simplify</h3>
            <p class="text-charcoal-light">
              If a system makes life harder for the people using it, it's not the right system. We build for operators, supervisors, and plant managers, not for IT.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Scripture -->
  <section class="bg-charcoal text-white py-16">
    <div class="container mx-auto px-6">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-xl italic text-gray-300 mb-3">"{company.guidingScripture.text}"</p>
        <p class="text-gray-500 text-sm">{company.guidingScripture.citation}</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16">
    <div class="container mx-auto px-6">
      <ContactCTA />
    </div>
  </section>
</BaseLayout>
