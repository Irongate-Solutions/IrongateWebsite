---
export interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
}

const { title, description, href, icon } = Astro.props;
---

<a href={href} class="group block bg-white p-8 rounded-lg border border-charcoal/10 hover:border-copper transition-all hover:shadow-lg">
  <div class="text-4xl mb-4">{icon}</div>
  <h3 class="font-heading text-xl font-bold text-charcoal mb-3 group-hover:text-copper transition-colors">{title}</h3>
  <p class="text-charcoal-light mb-4">{description}</p>
  <span class="text-copper font-medium group-hover:text-copper-dark transition-colors">
    Learn more &rarr;
  </span>
</a>
